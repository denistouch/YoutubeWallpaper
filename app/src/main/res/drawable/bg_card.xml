<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- В фокусе: светлее + яркая акцентная рамка -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <!-- Выбранное (но не в фокусе): тонировка + тонкая рамка -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_selected" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <!-- Обычное -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/surface_variant" />
        </shape>
    </item>
</selector>
