<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg"
    android:paddingHorizontal="48dp"
    android:paddingVertical="27dp">

    <!-- ЛЕВАЯ ПАНЕЛЬ: заголовок, ввод ссылки, крупный список с превью -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.7"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="@color/on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_video"
            style="@style/SectionHeader" />

        <!-- Два способа добавить видео -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/addFromPhoneButton"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="52dp"
                android:text="@string/add_from_phone_button"
                app:icon="@drawable/ic_qr_code"
                app:iconGravity="textStart" />

            <Button
                android:id="@+id/showManualInputButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:text="@string/add_manually_button" />
        </LinearLayout>

        <!-- Блок ручного ввода: скрыт по умолчанию, открывается кнопкой выше -->
        <LinearLayout
            android:id="@+id/manualAddBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:hint="@string/url_hint"
                android:textColorHint="@color/on_surface_muted"
                android:textColor="@color/on_surface"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:maxLines="1" />

            <Button
                android:id="@+id/addButton"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:text="@string/add_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/empty_list_hint"
            android:textColor="@color/on_surface_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/videoList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="4dp"
            android:clipToPadding="false"
            android:clipChildren="false" />
    </LinearLayout>

    <!-- ПРАВАЯ ПАНЕЛЬ: компактное управление заставкой и таймаутом -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="40dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_screensaver"
                style="@style/SectionHeader" />

            <TextView
                android:id="@+id/screensaverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="@drawable/bg_input"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:text="@string/status_checking" />

            <Button
                android:id="@+id/makeActiveButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/make_active_button" />

            <Button
                android:id="@+id/playButton"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/play_now_button" />

            <!-- Подсказка про разрешение: скрыта, появляется только после неудачной попытки -->
            <TextView
                android:id="@+id/permissionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="@drawable/bg_input"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@color/surface_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/timeout_label"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/timeoutButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="80dp"
                    android:text="— мин" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
